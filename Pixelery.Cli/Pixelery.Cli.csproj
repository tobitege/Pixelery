<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pixelery.Cli</RootNamespace>
    <AssemblyName>pixelery</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- dotnet publish -r win-x64 creates one self-contained, compressed pixelery.exe (release asset). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pixelery.Core\Pixelery.Core.csproj" />
  </ItemGroup>

  <!-- Native packages ship symbol files (libSkiaSharp.pdb, ~80 MB); keep them out of the release. -->
  <Target Name="ExcludePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
