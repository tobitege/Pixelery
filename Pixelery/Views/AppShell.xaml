<UserControl
    x:Class="Pixelery.Views.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:daisy="using:Flowery.Controls"
    xmlns:localization="using:Pixelery.Localization"
    xmlns:views="using:Pixelery.Views">

    <Grid x:Name="RootGrid"
          x:DataType="localization:AppLocalization"
          RowDefinitions="Auto,*"
          DataContext="{x:Bind Localization, Mode=OneWay}"
          daisy:DaisyBaseContentControl.NeumorphicScopeEnabled="False">

        <TitleBar x:Name="AppTitleBar"
                  Title="{Binding [App_Title]}"
                  IsBackButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/app_icon.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <daisy:DaisyLoading x:Name="RunIndicator"
                                        Size="ExtraSmall"
                                        Variant="Spinner"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center" />
                    <daisy:DaisyButton x:Name="GitHubButton"
                                       Variant="Ghost"
                                       Shape="Square"
                                       Size="Small"
                                       VerticalAlignment="Center"
                                       IconData="{StaticResource DaisyIconBrandGitHub}"
                                       daisy:FlowerySizeManager.IgnoreGlobalSize="True"
                                       Click="GitHubButton_Click" />
                    <daisy:DaisyButton x:Name="SettingsButton"
                                       Variant="Ghost"
                                       Shape="Square"
                                       Size="Small"
                                       VerticalAlignment="Center"
                                       IconData="{StaticResource DaisyIconSettings}"
                                       daisy:FlowerySizeManager.IgnoreGlobalSize="True"
                                       Click="SettingsButton_Click" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Border x:Name="PageSurface"
                Grid.Row="1"
                Background="{ThemeResource DaisyBase100Brush}"
                BorderBrush="{ThemeResource DaisyBase300Brush}"
                BorderThickness="0,1,0,0">
            <views:GeneratorView x:Name="Generator" />
        </Border>

        <daisy:DaisyToast x:Name="Toasts"
                          Grid.RowSpan="2"
                          HorizontalPosition="Center"
                          VerticalPosition="Bottom"
                          ToastOffset="16,16,16,32" />

        <!-- Settings: cancellable modal dialog, created on first use (x:Load) to keep startup fast. -->
        <daisy:DaisyModal x:Name="SettingsDialog" Grid.RowSpan="2" IsOpen="False" x:Load="False">
            <!-- Accent frame at the dialog edge: DaisyModal pads its content by 24 and rounds its corners by 16;
                 the negative margin puts this border exactly on the dialog outline. -->
            <Border x:Name="SettingsDialogFrame" Margin="-24" Padding="24" CornerRadius="16" BorderThickness="1">
                <Grid x:Name="SettingsDialogContent" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding [Settings_Title]}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   daisy:FlowerySizeManager.ResponsiveFont="Header" />
                        <daisy:DaisyButton x:Name="SettingsCloseButton"
                                           Grid.Column="1"
                                           Variant="Ghost"
                                           Shape="Circle"
                                           IconSymbol="Cancel"
                                           Click="SettingsCancel_Click" />
                    </Grid>
                    <views:SettingsView x:Name="SettingsPage" Grid.Row="1" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <daisy:DaisyButton x:Name="SettingsCancelButton"
                                           Variant="Neutral"
                                           Content="{Binding [App_Cancel]}"
                                           Click="SettingsCancel_Click" />
                        <daisy:DaisyButton x:Name="SettingsOkButton"
                                           Variant="Primary"
                                           MinWidth="96"
                                           Content="{Binding [App_Ok]}"
                                           Click="SettingsOk_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </daisy:DaisyModal>

        <!-- Watermark editor, created on first use -->
        <daisy:DaisyModal x:Name="WatermarkDialog" Grid.RowSpan="2" IsOpen="False" x:Load="False">
            <Border x:Name="WatermarkDialogFrame" Margin="-24" Padding="24" CornerRadius="16" BorderThickness="1">
                <Grid x:Name="WatermarkDialogContent" RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding [Wm_Title]}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   daisy:FlowerySizeManager.ResponsiveFont="Header" />
                        <daisy:DaisyButton x:Name="WatermarkCloseButton"
                                           Grid.Column="1"
                                           Variant="Ghost"
                                           Shape="Circle"
                                           IconSymbol="Cancel"
                                           Click="WatermarkCancel_Click" />
                    </Grid>
                    <views:WatermarkEditor x:Name="WatermarkEditorView" Grid.Row="1" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <daisy:DaisyButton Variant="Neutral"
                                           Content="{Binding [App_Cancel]}"
                                           Click="WatermarkCancel_Click" />
                        <daisy:DaisyButton Variant="Primary"
                                           MinWidth="96"
                                           Content="{Binding [App_Ok]}"
                                           Click="WatermarkOk_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </daisy:DaisyModal>

        <!-- Large preview of one style, created on first use -->
        <daisy:DaisyModal x:Name="PreviewDialog" Grid.RowSpan="2" IsOpen="False" x:Load="False">
            <Border x:Name="PreviewDialogFrame" Margin="-24" Padding="24" CornerRadius="16" BorderThickness="1">
                <Grid x:Name="PreviewDialogContent" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewTitle"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       daisy:FlowerySizeManager.ResponsiveFont="Header" />
                            <daisy:DaisyBadge x:Name="PreviewCategory" Variant="Secondary" VerticalAlignment="Center" />
                        </StackPanel>
                        <daisy:DaisyButton x:Name="PreviewCloseButton"
                                           Grid.Column="1"
                                           Variant="Ghost"
                                           Shape="Circle"
                                           IconSymbol="Cancel"
                                           Click="PreviewClose_Click" />
                    </Grid>
                    <Grid x:Name="PreviewImageFrame"
                          Grid.Row="1"
                          CornerRadius="12"
                          Background="{ThemeResource DaisyBase300Brush}">
                        <Border BorderThickness="1" BorderBrush="Transparent" CornerRadius="12">
                            <Grid>
                                <daisy:DaisyLoading x:Name="PreviewDialogLoading"
                                                    Variant="Dots"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                <Image x:Name="PreviewDialogImage" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <Border BorderThickness="1"
                                BorderBrush="{ThemeResource DaisySecondaryBrush}"
                                CornerRadius="12"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind PreviewDialogLoading.Visibility, Mode=OneWay}" />
                    </Grid>
                    <TextBlock x:Name="PreviewDescription"
                               Grid.Row="2"
                               Opacity="0.8"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource DaisyBaseContentBrush}"
                               daisy:FlowerySizeManager.ResponsiveFont="Primary" />
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                        <daisy:DaisyCheckBox x:Name="PreviewSlideshowCheck"
                                             Variant="Primary"
                                             Content="{Binding [Tab_Slideshow]}"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="{Binding [Tab_Slideshow]}" />
                        <daisy:DaisyNumericUpDown x:Name="PreviewSlideshowSeconds"
                                                Grid.Column="1"
                                                Width="100"
                                                MaxDecimalPlaces="0"
                                                MaxIntegerDigits="3"
                                                FormatString="0"
                                                Suffix="s"
                                                Size="Small"
                                                VerticalAlignment="Center"
                                                daisy:FlowerySizeManager.IgnoreGlobalSize="True"
                                                AutomationProperties.Name="{Binding [Slide_Seconds]}"
                                                ToolTipService.ToolTip="{Binding [Slide_Seconds]}" />
                        <TextBlock x:Name="PreviewInfo"
                                   Grid.Column="2"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource DaisyBaseContentBrush}"
                                   daisy:FlowerySizeManager.ResponsiveFont="Secondary" />
                        <daisy:DaisyButton x:Name="PreviewFullScreenButton"
                                           Grid.Column="3"
                                           Variant="Primary"
                                           Shape="Square"
                                           IconData="{StaticResource AppIconFullScreen}"
                                           Click="PreviewFullScreen_Click" />
                        <daisy:DaisyButton x:Name="PreviewShuffleButton"
                                           Grid.Column="4"
                                           Variant="Primary"
                                           IconData="{StaticResource AppIconShuffle}"
                                           Click="PreviewShuffle_Click" />
                    </Grid>
                </Grid>
            </Border>
        </daisy:DaisyModal>
    </Grid>
</UserControl>
