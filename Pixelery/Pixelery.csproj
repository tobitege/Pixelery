<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>Pixelery</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <OutputType>WinExe</OutputType>
    <ApplicationTitle>Pixelery</ApplicationTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <DefaultLanguage>en-US</DefaultLanguage>
    <NoWarn>$(NoWarn);PRI263</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- dotnet publish creates one self-contained, compressed Pixelery.exe (release asset). -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flowery.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <ProjectReference Include="..\Pixelery.Core\Pixelery.Core.csproj" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="$(AssemblyName).Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.svg;Assets\Previews\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- WinUI ships its control strings (Microsoft.ui.xaml.dll.mui) in 86 culture folders; keep only the app's 12 languages
       (other cultures fall back to en-us). The self-contained Windows App SDK target adds them as None items linked to "<culture>\". -->
  <Target Name="TrimWindowsAppSDKMuiLanguages" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <PropertyGroup>
      <_KeepMuiCultures>;en-us;de-de;fr-fr;es-es;it-it;ja-jp;ko-kr;zh-cn;ar-sa;tr-tr;uk-ua;he-il;</_KeepMuiCultures>
    </PropertyGroup>
    <ItemGroup>
      <_MuiFiles Include="@(None)" Condition="'%(Extension)' == '.mui'" />
      <_DropMui Include="@(_MuiFiles)"
                Condition="!$(_KeepMuiCultures.Contains(';$([System.IO.Path]::GetDirectoryName('%(Link)').ToLowerInvariant());'))" />
      <None Remove="@(_DropMui)" />
      <_MuiFiles Remove="@(_MuiFiles)" />
      <_DropMui Remove="@(_DropMui)" />
    </ItemGroup>
  </Target>

  <!-- Native packages ship symbol files (libSkiaSharp.pdb, ~80 MB); keep them out of the release. -->
  <Target Name="ExcludePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
