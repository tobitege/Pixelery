<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>Pixelery</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <OutputType>WinExe</OutputType>
    <ApplicationTitle>Pixelery</ApplicationTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <DefaultLanguage>en-US</DefaultLanguage>
    <NoWarn>$(NoWarn);PRI263</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Release publishes native code with the self-contained Windows App SDK beside it. -->
  <PropertyGroup>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Chrome.DevTools.WinUI" Condition="'$(Configuration)' == 'Debug'" />
    <!-- CDP currently brings SQLite 2.1.11, which has a known native-library vulnerability. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Flowery.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" PrivateAssets="all" />
    <ProjectReference Include="..\Pixelery.Core\Pixelery.Core.csproj" />
    <ProjectReference Include="..\Pixelery.Updates\Pixelery.Updates.csproj" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="$(AssemblyName).Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.svg;Assets\Previews\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- WinUI ships its control strings (Microsoft.ui.xaml.dll.mui) in 86 culture folders; keep only the app's 12 languages
       (other cultures fall back to en-us). The self-contained Windows App SDK target adds them as None items linked to "<culture>\". -->
  <Target Name="TrimWindowsAppSDKMuiLanguages" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <PropertyGroup>
      <_KeepMuiCultures>;en-us;de-de;fr-fr;es-es;it-it;ja-jp;ko-kr;zh-cn;ar-sa;tr-tr;uk-ua;he-il;</_KeepMuiCultures>
    </PropertyGroup>
    <ItemGroup>
      <_MuiFiles Include="@(None)" Condition="'%(Extension)' == '.mui'" />
      <_DropMui Include="@(_MuiFiles)"
                Condition="!$(_KeepMuiCultures.Contains(';$([System.IO.Path]::GetDirectoryName('%(Link)').ToLowerInvariant());'))" />
      <None Remove="@(_DropMui)" />
      <_MuiFiles Remove="@(_MuiFiles)" />
      <_DropMui Remove="@(_DropMui)" />
    </ItemGroup>
  </Target>

  <!-- Native packages ship symbol files (libSkiaSharp.pdb, ~80 MB); keep them out of the release. -->
  <Target Name="ExcludePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
