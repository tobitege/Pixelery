<UserControl
    x:Class="AbstractImg.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:daisy="using:Flowery.Controls">

    <ScrollViewer x:Name="RootScroller" Padding="28,18,28,28" DataContext="{x:Bind Localization, Mode=OneWay}">
        <StackPanel x:Name="PageStack" MaxWidth="860" HorizontalAlignment="Stretch" Spacing="16">

            <!-- Appearance -->
            <Border Style="{StaticResource AppSectionStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [Settings_Appearance]}" Style="{StaticResource AppSectionHeaderStyle}" Margin="0,0,0,6" daisy:FlowerySizeManager.ResponsiveFont="SectionHeader" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock Text="{Binding [Settings_Theme]}" Style="{StaticResource AppLabelStyle}" daisy:FlowerySizeManager.ResponsiveFont="Primary" />
                        <daisy:DaisyThemeDropdown x:Name="ThemeDropdown" Grid.Column="1" Width="240" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Settings_Size]}" Style="{StaticResource AppLabelStyle}" daisy:FlowerySizeManager.ResponsiveFont="Primary" />
                            <TextBlock Text="{Binding [Settings_SizeHint]}" Style="{StaticResource AppLabelStyle}" Opacity="0.6" daisy:FlowerySizeManager.ResponsiveFont="Secondary" />
                        </StackPanel>
                        <daisy:DaisySizeDropdown x:Name="SizeDropdown" Grid.Column="1" Width="240" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock Text="{Binding [Settings_Language]}" Style="{StaticResource AppLabelStyle}" daisy:FlowerySizeManager.ResponsiveFont="Primary" />
                        <daisy:DaisySelect x:Name="LanguageSelect" Grid.Column="1" Width="240" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Generation -->
            <Border Style="{StaticResource AppSectionStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [Settings_Generation]}" Style="{StaticResource AppSectionHeaderStyle}" Margin="0,0,0,6" daisy:FlowerySizeManager.ResponsiveFont="SectionHeader" />
                    <StackPanel x:Name="GenerationOptions" Spacing="12" />
                </StackPanel>
            </Border>

            <!-- Shortcuts -->
            <Border Style="{StaticResource AppSectionStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding [Settings_Shortcuts]}" Style="{StaticResource AppSectionHeaderStyle}" Margin="0,0,0,6" daisy:FlowerySizeManager.ResponsiveFont="SectionHeader" />
                    <Grid x:Name="ShortcutsGrid" ColumnSpacing="16" RowSpacing="8" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource AppSectionStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Image x:Name="AboutIcon" Width="56" Height="56" VerticalAlignment="Top">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/app_icon.svg" RasterizePixelWidth="112" RasterizePixelHeight="112" />
                        </Image.Source>
                    </Image>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding [App_Title]}" Style="{StaticResource AppSectionHeaderStyle}" daisy:FlowerySizeManager.ResponsiveFont="SectionHeader" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource AppLabelStyle}" Opacity="0.7" daisy:FlowerySizeManager.ResponsiveFont="Primary" />
                        <TextBlock Text="{Binding [Settings_AboutText]}" Style="{StaticResource AppLabelStyle}" Opacity="0.7" daisy:FlowerySizeManager.ResponsiveFont="Primary" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <daisy:DaisyButton x:Name="FloweryButton"
                                               Content="Flowery.WinUI"
                                               IconData="{StaticResource DaisyIconBrandGitHub}"
                                               Variant="Primary"
                                               Size="Small"
                                               Click="FloweryButton_Click" />
                            <daisy:DaisyButton x:Name="DataFolderButton"
                                               Content="{Binding [Settings_OpenDataFolder]}"
                                               IconSymbol="Folder"
                                               Variant="Primary"
                                               Size="Small"
                                               Click="DataFolderButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
